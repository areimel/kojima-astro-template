---
import BaseHead from "@/components/BaseHead.astro";
import { Footer } from "@/components/blocks/footer";
import { Navbar } from "@/components/blocks/navbar";
const { title, description, image } = Astro.props;
---

<html lang="en" data-theme="kojima" class="dark">
  <head><BaseHead title={title} description={description} image={image} /></head
  >
  <body class="bg-background text-foreground min-h-screen antialiased">
    <a
      href="#main-content"
      class="bg-primary text-primary-foreground sr-only fixed top-2 left-2 z-50 px-5 py-3 font-mono text-sm focus:not-sr-only focus:fixed"
      >Skip to content</a
    >
    <Navbar pathname={Astro.url.pathname} client:load />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
