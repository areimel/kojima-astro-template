---
import { Background } from "@/components/background";
import { buttonVariants } from "@/components/ui/button";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
---

<DefaultLayout
  title="404 — Signal not found | Kojima"
  description="This Kojima page could not be found. Return to the overview or explore the field notes."
>
  <Background>
    <section class="container max-w-5xl py-12 lg:py-16">
      <div
        class="grid border border-border bg-background md:grid-cols-[1fr_2fr]"
      >
        <div
          aria-hidden="true"
          class="flex min-h-48 flex-col justify-between border-b border-border bg-muted/30 p-8 md:border-r md:border-b-0"
        >
          <span
            class="text-muted-foreground font-mono text-xs uppercase tracking-widest"
            >Route / Unresolved</span
          >
          <span class="font-mono text-8xl tracking-tighter">404</span>
          <div class="mt-6 grid grid-cols-8 gap-2">
            {
              Array.from({ length: 8 }, (_, index) => (
                <span
                  class:list={[
                    "h-2 border border-border",
                    index < 3 ? "bg-foreground/30" : "bg-background",
                  ]}
                />
              ))
            }
          </div>
        </div>
        <div class="p-8 md:p-12">
          <p
            class="text-muted-foreground mb-6 font-mono text-xs uppercase tracking-widest"
          >
            Kojima / Page not found
          </p>
          <h1 class="text-4xl tracking-tight md:text-5xl">Signal not found.</h1>
          <p class="text-muted-foreground mt-6 max-w-lg leading-relaxed">
            This address does not resolve to a page. Check the URL, return to
            the overview, or continue through the field notes.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/" data-slot="button" class={buttonVariants({ size: "lg" })}>Return to overview</a>
            <a href="/blog" data-slot="button" class={buttonVariants({ variant: "outline", size: "lg" })}>Explore field notes</a>
          </div>
        </div>
      </div>
    </section>
  </Background>
</DefaultLayout>
